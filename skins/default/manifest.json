{
  "name": "default",
  "version": "1.1.0",
  "frameWidth": 192,
  "frameHeight": 192,
  "defaultState": "idle",
  "states": {
    "idle": {
      "file": "idle.png",
      "frames": 24,
      "fps": 12,
      "loop": true,
      "variantChance": 0.15,
      "variants": [
        { "file": "idle-look.png", "frames": 18, "fps": 12 },
        { "file": "idle-stretch.png", "frames": 20, "fps": 12 }
      ]
    },
    "working": {
      "file": "working.png",
      "frames": 12,
      "fps": 12,
      "loop": true,
      "variantChance": 0.08,
      "variants": [{ "file": "working-focus.png", "frames": 16, "fps": 12 }]
    },
    "resting": { "file": "resting.png", "frames": 8, "fps": 12, "loop": true },
    "thinking": { "file": "thinking.png", "frames": 16, "fps": 12, "loop": true },
    "speaking": { "file": "speaking.png", "frames": 8, "fps": 12, "loop": true },
    "happy": { "file": "happy.png", "frames": 12, "fps": 12, "loop": true },
    "celebrating": { "file": "celebrate.png", "frames": 16, "fps": 12, "loop": false },
    "alert": { "file": "alert.png", "frames": 8, "fps": 12, "loop": true }
  },
